<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The player holds a partial + Wi-Fi wakelock while streaming
         (ExoPlayer WAKE_MODE_NETWORK) so the radio can't drop into power-save
         mid-stream and stall playback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads run in a foreground dataSync service so the queue keeps
         going while the user is elsewhere or the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+: the download notification needs this to be visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for exporting into the public Downloads folder on API < 29;
         API 29+ goes through MediaStore and needs no storage permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".HikariApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Hikari">

        <!-- Play Services version metadata. NOT a Play Services dependency — the
             app never talks to GMS — but the System WebView's own bundled
             Play-Services shim READS this tag the moment a page touches the
             Shape Detection APIs (BarcodeDetector/FaceDetector, which several
             streaming/Cloudflare pages do). Without the tag its availability
             check throws GooglePlayServicesMissingManifestValueException on
             Chromium's in-proc GPU thread, rethrows through JNI, and kills the
             whole process — the recurring crash on a realme 5i running
             Android 16 (see crash reports: bindBarcodeDetectionProvider →
             GooglePlayServicesMissingManifestValueException). With a value
             present, that same check answers normally ("Play Services not
             available") and WebView simply skips the feature instead of dying.
             The number is the standard GMS version int; it only has to be a
             plausible integer, nothing else reads it. -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="12451000" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
android:name=".player.PlayerActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Hikari.Player" />

        <activity
            android:name=".web.WebViewActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Hikari.App" />

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Keeps catalog loads, searches and provider scans running while the
             user is in another app (see BackgroundWork / WorkService). -->
        <service
            android:name=".work.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
