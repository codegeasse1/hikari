<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The player holds a partial + Wi-Fi wakelock while streaming
         (ExoPlayer WAKE_MODE_NETWORK) so the radio can't drop into power-save
         mid-stream and stall playback. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Downloads run in a foreground dataSync service so the queue keeps
         going while the user is elsewhere or the screen is off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+: the download notification needs this to be visible. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for exporting into the public Downloads folder on API < 29;
         API 29+ goes through MediaStore and needs no storage permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ==================================================================
         ONE APK, PHONES AND TELEVISIONS

         The same APK installs on a phone/tablet and on a television (Android
         TV, Google TV, Fire TV) and picks its layout from the device it finds
         itself on — see com.hikari.app.tv.TvMode. These two lines are what make
         that possible at the *store/launcher* level, and both are
         required="false" on purpose:

          * android.hardware.touchscreen required=false — THE one that matters
            on a TV. A launcher filters out any app whose declared features the
            device lacks, and a television has no touchscreen: leaving this
            implied as required is what makes an APK invisible (uninstallable)
            on every television.
          * android.software.leanback required=false — leanback is the d-pad /
            10-foot feature that Android TV and Google TV declare. Declared
            optional so the ordinary phone install is unaffected.
         ================================================================== -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".HikariApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Hikari">

        <!-- Play Services version metadata. NOT a Play Services dependency — the
             app never talks to GMS — but the System WebView's own bundled
             Play-Services shim READS this tag the moment a page touches the
             Shape Detection APIs (BarcodeDetector/FaceDetector, which several
             streaming/Cloudflare pages do). Without the tag its availability
             check throws GooglePlayServicesMissingManifestValueException on
             Chromium's in-proc GPU thread, rethrows through JNI, and kills the
             whole process — the recurring crash on a realme 5i running
             Android 16 (see crash reports: bindBarcodeDetectionProvider →
             GooglePlayServicesMissingManifestValueException). With a value
             present, that same check answers normally ("Play Services not
             available") and WebView simply skips the feature instead of dying.
             The number is the standard GMS version int; it only has to be a
             plausible integer, nothing else reads it. -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="12451000" />

        <!-- MainActivity has NO launcher intent-filter of its own: the launcher
             entry is one of the activity-aliases below, each carrying a
             different icon. Exactly one alias is enabled at a time, and
             MainActivity itself is never disabled (so explicit
             Intent(..., MainActivity::class.java) PendingIntents — the download
             and update notifications — always resolve).

             To add another icon: drop the icon resources in, add an alias here
             with enabled="false", and add its entry to
             com.hikari.app.ui.AppIconVariants. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection|fontScale|density" />

        <!-- The official Hikari icon: the only alias enabled in the manifest,
             i.e. what a fresh install (and a factory-reset state) shows. -->
        <activity-alias
            android:name="com.hikari.app.icon.Classic"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.Cine"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v2"
            android:roundIcon="@mipmap/ic_launcher_v2"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.OrbitPlay"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v3"
            android:roundIcon="@mipmap/ic_launcher_v3"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.MoonStar"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v4"
            android:roundIcon="@mipmap/ic_launcher_v4"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.RedPlay"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v5"
            android:roundIcon="@mipmap/ic_launcher_v5"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.Sakura"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v6"
            android:roundIcon="@mipmap/ic_launcher_v6"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.EnsoPlay"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v7"
            android:roundIcon="@mipmap/ic_launcher_v7"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.SilverH"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v8"
            android:roundIcon="@mipmap/ic_launcher_v8"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.VioletPlay"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v9"
            android:roundIcon="@mipmap/ic_launcher_v9"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.Horizon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v10"
            android:roundIcon="@mipmap/ic_launcher_v10"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.hikari.app.icon.NekoMoon"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_v11"
            android:roundIcon="@mipmap/ic_launcher_v11"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The TELEVISION launcher entry.

             A television home screen lists what carries LEANBACK_LAUNCHER and
             draws the app's `banner` (a 320x180 image) instead of an icon, which
             is why this alias is the one that has one. It is deliberately:

              * always enabled and NEVER touched by the phone icon switching
                (AppIconManager only ever enables/disables the icon aliases
                above), so picking a different phone icon can never remove Hikari
                from a television's home screen; and
              * separate from the aliases above, because those carry
                CATEGORY_LAUNCHER and a television launcher does not list that —
                adding the leanback category to them would have made choosing an
                icon a TV-launcher decision as well. -->
        <activity-alias
            android:name="com.hikari.app.tv.Launcher"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:banner="@drawable/tv_banner"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
android:name=".player.PlayerActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Hikari.Player" />

        <activity
            android:name=".web.WebViewActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Hikari.App" />

        <!-- CloudStream plugins name com.lagradost.cloudstream3.MainActivity when
             they want to open "the app" (the CineStream plugin does it from its
             own settings dialog). The class is shadowed in
             java/com/lagradost/cloudstream3/MainActivity.kt; it must be declared
             here too, or a real startActivity() against it would throw
             ActivityNotFoundException — the same crash one step later. It is
             transparent and finishes immediately, because all it does is hand
             the user to Hikari's own main screen. -->
        <activity
            android:name="com.lagradost.cloudstream3.MainActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Keeps catalog loads, searches and provider scans running while the
             user is in another app (see BackgroundWork / WorkService). -->
        <service
            android:name=".work.WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
