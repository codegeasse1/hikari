<?xml version="1.0" encoding="utf-8"?>
<!-- Custom media3 PlayerControlView layout, following the reference player UI:
     a frosted top bar (round back button, title + metadata badges, then the
     round action buttons), a big centre play cluster with a cyan->violet
     gradient ring, and a bottom block of time labels flanking a gradient
     progress bar with the frosted pill row underneath.

     NOTE for anyone editing this file: XML comments may NOT contain a double
     hyphen, so do not draw ASCII rule lines inside them.

     IMPORTANT: media3 inspects this layout at runtime.
     (1) PlayerControlViewLayoutManager.onLayoutWidthChanged() assumes the LAST
         child of @id/exo_basic_controls is @id/exo_overflow_show, and it MOVES
         children of exo_basic_controls into the (invisible) extra-controls
         container once they stop fitting. Our own pill buttons therefore live
         in their own container (@+id/player_pills), never inside
         exo_basic_controls, and every media3 button inside exo_basic_controls
         is hidden, so nothing visible can be relocated or replaced by an
         overflow chevron.
     (2) updateLayoutForSizeChange()/useMinimalMode() size the centre cluster
         and the bottom bar; both are kept compact so minimal mode isn't
         triggered on ordinary phone windows.
     (3) @id/exo_time is intentionally absent: the position/duration labels sit
         on the same row as @id/exo_progress instead. media3 resolves the labels
         by id directly and treats a missing time container as zero width. -->

<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <View android:id="@id/exo_controls_background"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="#3D000000"/>

  <!-- Top bar: back button, title + metadata badges, round action buttons -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top"
      android:orientation="vertical"
      android:background="@drawable/top_bar_bg"
      android:paddingStart="10dp"
      android:paddingEnd="8dp"
      android:paddingTop="8dp"
      android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

      <ImageButton
          android:id="@+id/back_btn"
          android:layout_width="38dp"
          android:layout_height="38dp"
          android:src="@drawable/ic_back"
          android:tint="#FFFFFF"
          android:contentDescription="Back"
          android:background="@drawable/circle_glass_ripple"
          android:scaleType="centerInside" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center_vertical"
          android:paddingStart="12dp"
          android:paddingEnd="6dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipToPadding="false">

          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <!-- S1 E1 (episode line) / total runtime / quality / source, in the
                 same order the mockup shows them. -->
            <TextView
                android:id="@+id/subtitle_text"
                style="@style/HikariBadge"
                android:visibility="gone" />

            <TextView
                android:id="@+id/badge_duration"
                style="@style/HikariBadge"
                android:visibility="gone" />

            <TextView
                android:id="@+id/badge_quality"
                style="@style/HikariBadge.Accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/badge_source"
                style="@style/HikariBadge"
                android:visibility="gone" />
          </LinearLayout>
        </HorizontalScrollView>
      </LinearLayout>

      <!-- Round action buttons, in the mockup's right-hand slots. Each one is a
           real feature: favourite, download, picture-in-picture, player
           options (fit/crop/rotate) and screen lock. -->
      <ImageButton
          android:id="@+id/fav_btn"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:src="@drawable/ic_heart"
          android:tint="#FFFFFF"
          android:contentDescription="Favourite"
          android:background="@drawable/circle_glass_ripple"
          android:scaleType="centerInside" />

      <ImageButton
          android:id="@+id/download_btn"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginStart="5dp"
          android:src="@drawable/ic_download"
          android:tint="#FFFFFF"
          android:contentDescription="Download"
          android:background="@drawable/circle_glass_ripple"
          android:scaleType="centerInside" />

      <ImageButton
          android:id="@+id/pip_btn"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginStart="5dp"
          android:src="@drawable/ic_pip"
          android:tint="#FFFFFF"
          android:contentDescription="Picture-in-picture"
          android:background="@drawable/circle_glass_ripple"
          android:scaleType="centerInside" />

      <ImageButton
          android:id="@+id/options_btn"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginStart="5dp"
          android:src="@drawable/ic_settings"
          android:tint="#FFFFFF"
          android:contentDescription="Player options"
          android:background="@drawable/circle_glass_ripple"
          android:scaleType="centerInside" />

      <ImageButton
          android:id="@+id/lock_btn"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginStart="5dp"
          android:src="@drawable/ic_lock"
          android:tint="#FFFFFF"
          android:contentDescription="Lock controls"
          android:background="@drawable/circle_glass_ripple"
          android:scaleType="centerInside" />
    </LinearLayout>
  </LinearLayout>

  <!-- Bottom bar: time labels flanking the progress bar, then the pill row -->
  <LinearLayout
      android:id="@id/exo_bottom_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:orientation="vertical"
      android:background="@drawable/bottom_bar_bg"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:paddingTop="14dp"
      android:paddingBottom="6dp"
      android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

      <TextView
          android:id="@id/exo_position"
          style="@style/HikariTime"
          android:layout_marginStart="8dp" />

      <androidx.media3.ui.DefaultTimeBar
          android:id="@id/exo_progress"
          android:layout_width="0dp"
          android:layout_height="26dp"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:layout_marginEnd="8dp"
          app:bar_height="4dp"
          app:bar_gravity="center_vertical"
          app:touch_target_height="26dp"
          app:played_color="@color/hikari_accent_mid"
          app:buffered_color="#66FFFFFF"
          app:unplayed_color="#40FFFFFF"
          app:scrubber_color="#FFFFFF"
          app:scrubber_enabled_size="14dp"
          app:scrubber_dragged_size="19dp" />

      <TextView
          android:id="@id/exo_duration"
          style="@style/HikariTime"
          android:layout_marginEnd="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

      <!-- Our own pills. Deliberately a DIFFERENT parent from
           exo_basic_controls so media3's overflow logic can never move them,
           and scrollable so a narrow phone just scrolls the row. -->
      <HorizontalScrollView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:scrollbars="none"
          android:overScrollMode="never"
          android:clipToPadding="false"
          android:paddingStart="2dp"
          android:paddingEnd="2dp">

        <LinearLayout
            android:id="@+id/player_pills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="ltr">

          <TextView
              android:id="@+id/speed_btn"
              style="@style/HikariPill"
              android:drawableStart="@drawable/ic_speed"
              android:drawableEnd="@drawable/ic_chevron_down"
              android:text="1x" />

          <TextView
              android:id="@+id/episodes_btn"
              style="@style/HikariPill"
              android:drawableStart="@drawable/ic_episodes"
              android:text="Episodes" />

          <TextView
              android:id="@+id/sources_btn"
              style="@style/HikariPill.Accent"
              android:drawableStart="@drawable/ic_server"
              android:maxWidth="200dp"
              android:text="Source" />

          <TextView
              android:id="@+id/quality_btn"
              style="@style/HikariPill"
              android:drawableStart="@drawable/ic_quality"
              android:text="Quality" />

          <TextView
              android:id="@+id/audio_btn"
              style="@style/HikariPill"
              android:drawableStart="@drawable/ic_audio"
              android:text="Audio" />

          <TextView
              android:id="@+id/subs_btn"
              style="@style/HikariPill"
              android:drawableStart="@drawable/ic_subtitles"
              android:text="Subtitles" />

          <TextView
              android:id="@+id/skip_btn"
              style="@style/HikariPill.Accent"
              android:drawableStart="@drawable/ic_skip"
              android:text="Skip Intro" />
        </LinearLayout>
      </HorizontalScrollView>

      <!-- Pinned at the right edge (doesn't scroll with the pills): the
           fit/crop toggle, drawn as a round button like the mockup's far-right
           expand control. -->
      <ImageButton
          android:id="@+id/resize_btn"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="2dp"
          android:src="@drawable/ic_resize"
          android:tint="#FFFFFF"
          android:contentDescription="Fit or crop video"
          android:background="@drawable/circle_glass_ripple"
          android:scaleType="centerInside" />
    </LinearLayout>

    <!-- media3's own bottom buttons. All hidden (and all zero-width), and
         @id/exo_overflow_show is kept as the LAST child so the library's
         overflow logic, which is a no-op here, stays consistent. -->
    <LinearLayout
        android:id="@id/exo_basic_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr">

      <ImageButton android:id="@id/exo_vr"
          style="@style/ExoStyledControls.Button.Bottom.VR"
          android:visibility="gone" />

      <ImageButton android:id="@id/exo_shuffle"
          style="@style/ExoStyledControls.Button.Bottom.Shuffle"
          android:visibility="gone" />

      <ImageButton android:id="@id/exo_repeat_toggle"
          style="@style/ExoStyledControls.Button.Bottom.RepeatToggle"
          android:visibility="gone" />

      <ImageButton android:id="@id/exo_settings"
          style="@style/ExoStyledControls.Button.Bottom.Settings"
          android:visibility="gone" />

      <ImageButton android:id="@id/exo_fullscreen"
          style="@style/ExoStyledControls.Button.Bottom.FullScreen"
          android:visibility="gone" />

      <ImageButton android:id="@id/exo_overflow_show"
          style="@style/ExoStyledControls.Button.Bottom.OverflowShow"
          android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>

  <HorizontalScrollView android:id="@id/exo_extra_controls_scroll_view"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:visibility="invisible">

    <LinearLayout android:id="@id/exo_extra_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">

      <ImageButton android:id="@id/exo_overflow_hide"
          style="@style/ExoStyledControls.Button.Bottom.OverflowHide" />

    </LinearLayout>
  </HorizontalScrollView>

  <LinearLayout android:id="@id/exo_minimal_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_marginBottom="@dimen/exo_styled_minimal_controls_margin_bottom"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:layoutDirection="ltr"
      android:visibility="gone">

    <ImageButton android:id="@id/exo_minimal_fullscreen"
        style="@style/ExoStyledControls.Button.Bottom.FullScreen" />

  </LinearLayout>

  <!-- Centre cluster: prev 40 + 10 + rew 44 + 10 + play 68 + 10 + ffwd 44 + 10
       + next 40 = 276dp wide, with the "Tap to play" hint under the play
       button. Keeping the cluster small avoids media3's minimal mode. -->
  <LinearLayout
      android:id="@id/exo_center_controls"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:background="@android:color/transparent"
      android:orientation="vertical"
      android:gravity="center"
      android:clipToPadding="false"
      android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

      <ImageButton android:id="@id/exo_prev"
          style="@style/ExoStyledControls.Button.Center.Previous"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="@drawable/circle_glass_ripple"
          android:tint="#FFFFFF" />

      <FrameLayout
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_marginStart="10dp"
          android:layout_marginEnd="10dp"
          android:background="@drawable/circle_glass_ripple"
          android:addStatesFromChildren="true">
        <Button android:id="@id/exo_rew_with_amount"
            style="@style/ExoStyledControls.Button.Center.RewWithAmount"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:singleLine="false" />
      </FrameLayout>

      <ImageButton
          android:id="@id/exo_play_pause"
          style="@style/ExoStyledControls.Button.Center.PlayPause"
          android:layout_width="68dp"
          android:layout_height="68dp"
          android:padding="12dp"
          android:background="@drawable/player_play_ring" />

      <FrameLayout
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_marginStart="10dp"
          android:layout_marginEnd="10dp"
          android:background="@drawable/circle_glass_ripple"
          android:addStatesFromChildren="true">
        <Button android:id="@id/exo_ffwd_with_amount"
            style="@style/ExoStyledControls.Button.Center.FfwdWithAmount"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:singleLine="false" />
      </FrameLayout>

      <ImageButton android:id="@id/exo_next"
          style="@style/ExoStyledControls.Button.Center.Next"
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:background="@drawable/circle_glass_ripple"
          android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Shown by PlayerActivity only while playback is paused. -->
    <TextView
        android:id="@+id/play_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tap to play"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#DDFFFFFF"
        android:visibility="gone" />
  </LinearLayout>

</merge>
