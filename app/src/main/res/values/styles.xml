<resources>
    <!-- Player bottom-row pills (1x / Server / Skip / Fit / Quality / Audio /
         Subtitles / Download). One shared style keeps every pill the same
         height and corner radius so the row reads as a single, modern toolbar
         instead of a row of mismatched labels. -->
    <style name="HikariPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:background">@drawable/pill_glass_ripple</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:drawableTint">#FFFFFF</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>

    <!-- Accent pill: the toggled/featured state (playback speed, Skip Intro,
         Download) — the cyan→violet gradient fill. -->
    <style name="HikariPill.Accent">
        <item name="android:background">@drawable/pill_accent_ripple</item>
    </style>

    <!-- Older name kept so nothing that still references it breaks. -->
    <style name="HikariPlayerChip" parent="HikariPill" />
    <style name="HikariPlayerChip.Accent" parent="HikariPill.Accent" />

    <!-- Small metadata badges under the player title (episode / duration /
         quality / source), matching the reference player's pill row. -->
    <style name="HikariBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#F2FFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:background">@drawable/badge_glass</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <!-- Accent badge: the highlighted one (video quality). -->
    <style name="HikariBadge.Accent">
        <item name="android:background">@drawable/badge_accent</item>
    </style>

    <!-- Elapsed / total time labels that bracket the progress bar. -->
    <style name="HikariTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
