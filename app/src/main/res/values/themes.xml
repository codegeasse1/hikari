<resources>
    <style name="Theme.Hikari" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hikari_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Hikari.App</item>
    </style>

    <style name="Theme.Hikari.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hikari_bg</item>
        <item name="android:statusBarColor">@color/hikari_bg</item>
        <item name="android:navigationBarColor">@color/hikari_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Hikari.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
