<resources>
    <!-- NOTE: the white "Hikari" header users saw on every screen was the
         Android window title bar (it renders the app label). Every theme
         below now forces windowNoTitle + windowActionBar=false explicitly,
         so no activity can ever draw a title bar again. -->
    <style name="Theme.Hikari" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hikari_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Hikari.App</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.Hikari.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hikari_bg</item>
        <item name="android:statusBarColor">@color/hikari_bg</item>
        <item name="android:navigationBarColor">@color/hikari_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.Hikari.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- Brand accent: the media3 styled seekbar/progress and controls tint
             from colorAccent, so the player matches the app's gold instead of
             the Material default. -->
        <item name="android:colorAccent">#F5C569</item>
        <item name="android:colorControlActivated">#F5C569</item>
        <item name="android:colorControlHighlight">#33F5C569</item>
        <item name="android:colorControlNormal">#99FFFFFF</item>
    </style>
</resources>
