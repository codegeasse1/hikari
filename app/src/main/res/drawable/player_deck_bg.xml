<?xml version="1.0" encoding="utf-8"?>
<!-- The CINEMA skin's bottom deck: a solid dark panel with rounded top corners
     and a hairline edge, so the controls look like a piece of equipment under
     the picture instead of a gradient over it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F20A0C12"
        android:endColor="#E60E121A" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
