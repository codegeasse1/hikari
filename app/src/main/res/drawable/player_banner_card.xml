<?xml version="1.0" encoding="utf-8"?>
<!-- POSTER loading cover: the card the title's own poster sits on. A dark
     translucent pane with rounded corners and a hairline edge, matching the
     glass cards used everywhere else in the player. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hikari_glass_dark" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/hikari_glass_stroke" />
</shape>
