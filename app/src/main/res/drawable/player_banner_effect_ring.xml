<?xml version="1.0" encoding="utf-8"?>
<!-- Loading cover EFFECT "Aura ring": a ring of accent light around the card.

     A ROUNDED RECTANGLE, not a circle. It used to be `shape="oval"` at a fixed
     300dp, which is what the "the aura ring looks so bad, it's a circle" report
     was about: a circle drawn around a rectangular card crosses it at four
     points, so it reads as a stray outline instead of as the card's aura. A
     rounded rectangle follows the same corner curve the card does — the same
     thing the poster cards' own Aura ring draws — so the two look like one idea.

     Sized by its parent (`loading_ring_frame`, which is sized by the title block
     inside it), so the ring hugs whatever card the chosen loading style put up.

     PlayerActivity animates the alpha (see showLoadingBanner); it is NOT scaled,
     because scaling a ring that wraps a card pulls it off the card's edges. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <stroke
        android:width="2dp"
        android:color="@color/hikari_accent_mid" />
    <solid android:color="@android:color/transparent" />
</shape>
