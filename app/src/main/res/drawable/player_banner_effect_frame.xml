<?xml version="1.0" encoding="utf-8"?>
<!-- Loading cover EFFECT "Gallery frame": a hairline mount inset from the edges
     of the cover, the way a print sits inside a gallery frame. Static — it is
     the quietest of the loading effects, and it pairs with "Minimal". -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#38FFFFFF" />
    <solid android:color="@android:color/transparent" />
</shape>
