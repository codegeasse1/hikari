<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic scrim over the title-card backdrop: darkest at the top and
     bottom (where the status line sits) so the centred white title stays
     legible over any artwork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E6000000"
        android:centerColor="#40000000"
        android:endColor="#E6000000" />
</shape>
