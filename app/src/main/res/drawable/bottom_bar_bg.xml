<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-bar scrim: dark at the bottom fading up to transparent so the
     controls sit on a gradient like YouTube/mpv instead of a solid box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#E6000000"
        android:centerColor="#80000000"
        android:endColor="#00000000" />
</shape>
