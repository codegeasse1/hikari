<?xml version="1.0" encoding="utf-8"?>
<!-- Accent pill: the cyan -> violet gradient fill of the featured player
     controls (playback speed, Skip Intro, Download). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/hikari_accent_start"
        android:endColor="@color/hikari_accent_end" />
    <corners android:radius="22dp" />
</shape>
